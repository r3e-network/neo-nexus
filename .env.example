# NeoNexus signer integration. The recommended configuration is a bounded TOML
# registry containing any number of named local-wallet, local-signer, and
# neo-os-service profiles. The file contains paths to secrets, never secrets.
# See docs/signer-profiles.example.toml for a three-backend example.
# NEONEXUS_SIGNER_PROFILES_FILE=/etc/neo-nexus/signers.toml

# Do not combine the registry file with the compatibility variables below.
# Every registry route names a backend id explicitly; failures never fall back.
# Never put a wallet passphrase, bearer token, seed, WIF, or private key here.

# Compatibility: one process-local encrypted NEP-6 wallet. Transaction signing
# is structurally validated; consensus is refused (no durable anti-equivocation),
# and raw signing is off unless explicitly enabled.
# Startup decrypts the selected scalar once and keeps it zeroizing in memory
# until the profile's last clone drops; removing the password file does not relock it.
# NEONEXUS_SIGNER_BACKEND=local-wallet
# NEONEXUS_SIGNER_LOCAL_WALLET_PATH=/var/lib/neonexus/validator.wallet.json
# NEONEXUS_SIGNER_LOCAL_WALLET_PASSWORD_FILE=/run/secrets/neonexus-wallet-password
# NEONEXUS_SIGNER_LOCAL_WALLET_ACCOUNT=NNxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# NEONEXUS_SIGNER_LOCAL_WALLET_NETWORK=mainnet
# NEONEXUS_SIGNER_LOCAL_WALLET_NETWORK_MAGIC=860833102
# NEONEXUS_SIGNER_LOCAL_WALLET_ALLOW_TRANSACTION=true
# NEONEXUS_SIGNER_LOCAL_WALLET_ALLOW_CONSENSUS=false
# NEONEXUS_SIGNER_LOCAL_WALLET_ALLOW_RAW=false

# Compatibility: one locally deployed official Neo SecureSign gRPC signer.
# This is consensus-only and has no HTTP admin or relay surface.
# NEONEXUS_SIGNER_BACKEND=local-signer
# NEONEXUS_LOCAL_SIGNER_ENDPOINT=http://127.0.0.1:9991
# NEONEXUS_LOCAL_SIGNER_PUBLIC_KEY=031e18532fd4754c02f3041d9c75ceb33b83ffd81ac7ce4fe882ccb1c98bc5896e
# NEONEXUS_LOCAL_SIGNER_NETWORK_MAGIC=860833102

# Compatibility: one NeoOS signer service. HTTPS is mandatory.
# NEONEXUS_SIGNER_BACKEND=neo-os-service
# NEONEXUS_SIGNER_URL=https://signer.internal.example

# The single-service compatibility modes require exactly one file-backed admin
# identity. A multi-profile registry can additionally configure a separate,
# least-privilege signing identity per service profile.
# NEONEXUS_SIGNER_SERVICE_TIMEOUT_SECONDS=10
# NEONEXUS_SIGNER_ADMIN_TOKEN_FILE=/run/secrets/neo-nexus-signer-admin-token

# Workload admin alternative (do not combine with TOKEN_FILE):
# Requests use neoos-workload-v2 and sign the canonical NEONEXUS_SIGNER_URL
# origin as their audience; the signer must configure that same public origin.
# NEONEXUS_SIGNER_ADMIN_CALLER_ID=neo-nexus-admin
# NEONEXUS_SIGNER_ADMIN_WORKLOAD_KEY_FILE=/run/secrets/neo-nexus-admin-ed25519-seed
# NEONEXUS_SIGNER_ADMIN_WORKLOAD_SUBJECT=neo-nexus-production

# Only a bearer admin registered with allowed browser origins needs this:
# NEONEXUS_SIGNER_SERVICE_ORIGIN=https://nexus.internal.example

# Migration: URL-only settings remain a one-release HTTPS NeoOS compatibility
# path. NEONEXUS_SIGNER_SERVICE_URL is deprecated. Plaintext
# NEONEXUS_SIGNER_SERVICE_TOKEN is always refused.
