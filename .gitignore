# Rust build output
target/
# `target-wt/` is the cargo target directory of the baseline worktree checked
# out at ../neo-nexus-baseline. It is build output, but it lands inside this
# working directory, so the `target/` rule above does not reach it.
target-wt/
dist/

# Runtime data
.neonexus/
*.db
*.db-journal
*.db-wal
Data_LevelDB_*/
/nodes/

# Environment
.env
.env.local
.env.*.local

# Logs and temporary files
logs/
!src/**/logs/
!src/**/logs/*.rs
# `src/logs.rs` loads its unit tests from `tests/unit/logs/tests.rs` via #[path].
# Without this negation the `logs/` rule above excludes that file from the
# repository, and a fresh clone fails to compile the test target.
!tests/**/logs/
!tests/**/logs/*.rs
*.log
*.tmp
*.temp
.cache/

# IDE and OS
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# Process files
*.pid
*.pid.lock
*.seed
